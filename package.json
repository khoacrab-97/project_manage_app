{
  "name": "prmana-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract:source": "node scripts/extract-source.mjs src/lib/data/source/source-data.json",
    "package": "npm run build && node scripts/package-standalone.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:kiemtra": "tsx prisma/kiemtra-db.ts",
    "db:studio": "prisma studio",
    "db:kiemtra-danhmuc": "tsx prisma/kiemtra-danhmuc.ts",
    "db:matkhau": "tsx prisma/dat-mat-khau.ts",
    "db:kiemtra-quyen": "tsx prisma/kiemtra-quyen.ts",
    "db:thu-dang-nhap": "tsx prisma/thu-dang-nhap.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "better-sqlite3@12.11.1": true
  }
}